# Set ONE key. The first key found is used; force a provider with LLM_PROVIDER.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional
# LLM_PROVIDER=anthropic     # anthropic | openai | gemini | openrouter | groq | ollama
# LLM_MODEL=                 # override the provider's default model
# LLM_FALLBACK_MODELS=       # comma-separated models to fail over to when one's quota runs out
# TW_HEADED=1                # show the browser window
# TW_SLOW_MO=250             # slow browser actions down (milliseconds), nice for recording
# TW_MAX_STEPS=100
